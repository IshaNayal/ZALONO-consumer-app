{
  "entities": {
    "salons": {
      "title": "Salon",
      "description": "Partner salon profiles, services, stylists roster, and live slots availability",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "distanceKm": { "type": "number" },
        "travelTimeMin": { "type": "number" },
        "address": { "type": "string" },
        "area": { "type": "string" },
        "priceStart": { "type": "number" },
        "isOpen": { "type": "boolean" },
        "openingHours": { "type": "string" },
        "expectedWaitMin": { "type": "string" },
        "nextSlotTime": { "type": "string" },
        "queueCount": { "type": "number" },
        "stylistsCount": { "type": "number" },
        "availableStylistsCount": { "type": "number" },
        "busyLevel": { "type": "string" },
        "isVerified": { "type": "boolean" }
      },
      "required": ["name", "area", "isOpen"]
    },
    "bookings": {
      "title": "Booking",
      "description": "Real-time client appointments, live queue tracker position, and payment status",
      "type": "object",
      "properties": {
        "salonId": { "type": "string" },
        "salonName": { "type": "string" },
        "serviceName": { "type": "string" },
        "servicePrice": { "type": "number" },
        "slotTime": { "type": "string" },
        "date": { "type": "string" },
        "stylistName": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "status": { "type": "string" },
        "expectedWaitMin": { "type": "string" },
        "queuePosition": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "invoiceId": { "type": "string" }
      },
      "required": ["salonId", "serviceName", "customerName", "status"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
